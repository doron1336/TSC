# ============================================================================
# TSC repo: externalized artifacts (kept on disk, not tracked in git)
# ============================================================================
# See README.md "Repository layout" for what each folder contains.

# --- OS / IDE clutter (already filtered above for most, but be explicit) ----
.DS_Store
.idea/
.jbeval/
.qodo/

# --- Mat-file raw data (large, regenerable from public sources) -------------
*.mat

# --- NumPy arrays, pickles, logs (intermediate / cache) ---------------------
*.npy
*.pkl
*.log

# --- Top-level CSVs (per-dataset summary tables) ----------------------------
/datasets_scores.csv
/datasets_scores_4.csv
/dm_vs_classes_100.csv
/random_scores.csv
/random_scores_FaceAll.csv

# --- Top-level PNGs (one-off figures not used in the article) ---------------
/dm_ranking_vs_detached.png
/dm_ranking_vs_mrmr.png
/dm_ranking_vs_mrmr&relief.png
/dm_ranking_vs_mrmr_relief.png
/dm_ranking_vs_relief_mrmr.png
/kmeans_dm_ranking.png

# --- Top-level zip archive (raw input data download) ------------------------
/handmovement8-20240627T091740Z-001.zip

# --- LaTeX tables (regenerated by csv_to_latex.py / TSC/utils/csv_to_latex.py) --
/code/TSC/utils/HAR_table.tex
/code/TSC/utils/HAR_table_duration.tex
/code/TSC/utils/table.tex

# --- Big data directories (kept on disk; not tracked in git) ----------------
/UCRArchive_2018/                  # 44 GB — UCR Time Series Classification Archive
/handMovement_db/                  # 27 MB  — raw .mat files for handMovement experiments
/code/TSC/MMD/                     # 186 MB — torch-two-sample egg + GestureMidAirD2 cache (inside the package)
/code/TSC/MMD/GestureMidAirD2/
/code/TSC/MMD/torch-two-sample/
/POCKET/                           # 1 MB   — third-party pruning baselines

# --- Pipeline output directories (regenerated by the scripts) ---------------
/results_by_num_features/          # 332 KB  — per-num-features CSVs/pickles
/plots_averaged/                   # 1.9 MB  — averaged HAR plots
# (figures output by TSC/visualizations/*.py now goes to paths.FIGURES_DIR — usually plots_averaged/)